{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "files.exclude": {
      // LLVM is built from, never edited: keep it out of the explorer
      "llvm-project": true,
      "work/**": true,
      "dist/**": true,
    },
    "files.watcherExclude": {
      "llvm-project/**": true,
      "work/**": true,
      "dist/**": true,
    },
    "search.exclude": {
      "llvm-project/**": true,
      "qbe/**": true,
    },
    // Pylance need not index LLVM's thousands of Python files. Setting this
    // replaces Pylance's defaults, which are the first three entries.
    "python.analysis.exclude": [
      "**/node_modules",
      "**/__pycache__",
      "**/.*",
      "llvm-project",
      "work",
      "dist",
    ],
    "files.associations": {
      "VERSION": "plaintext",
      ".local-gitignore": "gitignore",
      ".github/workflows/exempt.txt": "gitignore",
      ".clangd": "yaml",
      "**/.claude/projects/*/memory/*.md": "plaintext",
      "no-ci.txt": "gitignore",
      "*.ssa": "plaintext",
    },
    "files.insertFinalNewline": true,
    "terminal.integrated.automationProfile.windows": {
      "path": "C:\\windows\\system32\\cmd.exe",
    },
    "ltex.additionalRules.motherTongue": "en-US",
  },
  "extensions": {
    "recommendations": [
      "timonwong.shellcheck",
      "streetsidesoftware.code-spell-checker",
      "streetsidesoftware.code-spell-checker-win32",
      "ltex-plus.vscode-ltex-plus",
    ]
  }
}
