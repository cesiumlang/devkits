{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "files.exclude": {
      "work/**": true,
      "dist/**": true,
    },
    "files.watcherExclude": {
      "llvm-project/**": true,
      "work/**": true,
      "dist/**": true,
    },
    "search.exclude": {
      "llvm-project/**": true,
      "qbe/**": true,
    },
    "files.associations": {
      ".local-gitignore": "gitignore",
      "no-ci.txt": "gitignore",
      "*.ssa": "plaintext",
    },
    "files.insertFinalNewline": true,
    "ltex.additionalRules.motherTongue": "en-US",
  },
  "extensions": {
    "recommendations": [
      "timonwong.shellcheck",
      "streetsidesoftware.code-spell-checker",
      "streetsidesoftware.code-spell-checker-win32",
      "ltex-plus.vscode-ltex-plus",
    ]
  }
}
