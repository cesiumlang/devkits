[submodule "qbe"]
	path = qbe
	url = git://c9x.me/qbe.git
[submodule "llvm-project"]
	path = llvm-project
	url = https://github.com/llvm/llvm-project.git
	shallow = true
	# several gigabytes checked out, and needed only to build a devkit: a
	# recursive clone or update skips it. Get it with
	#   git submodule update --init --checkout --depth 1 llvm-project
	update = none
